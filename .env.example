# Copy to .env and fill in an API key.

# LLM_MODEL is "<provider>:<model>", parsed by LangChain's init_chat_model.
# Enable one of the groups below and leave the rest commented out.

# Recommended: OpenRouter's free models. No payment needed, normal response speed.
# openrouter/free picks a free model at random, so answers may come from a different model each time.
LLM_MODEL=openrouter:openrouter/free
OPENROUTER_API_KEY=

# Anthropic (paid, most consistent quality):
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# OpenAI (paid):
# LLM_MODEL=openai:<model name>
# OPENAI_API_KEY=

# Not recommended: the free tier of the NVIDIA API Catalog (build.nvidia.com).
# It is free, but when tested on 2026-09-30 a 50-token response took about 2 minutes.
# This project sends 2-3 requests per question, so it simply times out.
# LLM_MODEL=nvidia:deepseek-ai/deepseek-v4.1-flash
# NVIDIA_API_KEY=

# Optional; defaults are in app/config.py. Re-run ingest after changing any of these.
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CHUNK_SIZE=450
# CHUNK_OVERLAP=50
