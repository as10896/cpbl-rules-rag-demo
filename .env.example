# Copy to .env and fill in an API key.

# LLM_MODEL is "<provider>:<model>", parsed by LangChain's init_chat_model.
# Enable one of the groups below and leave the rest commented out.

# Recommended: a specific free model on OpenRouter. No payment needed.
# Pinning one model means every request is answered by the same model.
# As of September 2026, free models are limited to 50 requests per day per account (1000 once
# the account has bought 10 credits) and 20 per minute; see https://openrouter.ai/docs/api-reference/limits
# for the current figures. One question uses up to 3 requests, so that is about 16 questions a day.
# When the limit is hit the UI shows "Rate limit exceeded: free-models-per-day".
# Free models share an upstream rate limit and the list changes over time: if this one
# returns 429 or disappears, pick another id ending in ":free" from https://openrouter.ai/models
# Do not use the `openrouter/free` router instead. It picks a free model at random for every
# request, and the pool includes models that are not chat models: a content-safety classifier
# answered a question here with just "User Safety: safe".
LLM_MODEL=openrouter:inclusionai/ling-3.0-flash-sante:free
OPENROUTER_API_KEY=

# Anthropic (paid, most consistent quality):
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# OpenAI (paid):
# LLM_MODEL=openai:<model name>
# OPENAI_API_KEY=

# Optional; defaults are in app/config.py. Re-run ingest after changing any of these.
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CHUNK_SIZE=450
# CHUNK_OVERLAP=50
